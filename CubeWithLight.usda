#usda 1.0
(
    defaultPrim = "Scene"
    upAxis = "Y"
    metersPerUnit = 1
    timeCodesPerSecond = 24
    startTimeCode = 0
    endTimeCode = 124
)

def "Scene"
{
    def Cube "Cube" (
    prepend apiSchemas = ["UsdShadeMaterialBindingAPI"]
    )
        {
            float size = 0.3

            float3 xformOp:translate.timeSamples = {
                0:   (0.0, 0.0,  0.00),
                4:   (0.0, 0.0,  0.13),
                9:   (0.0, 0.0,  0.26),
