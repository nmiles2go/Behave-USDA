                110: (0.0, 0.0, -0.37),
                114: (0.0, 0.0, -0.26),
                119: (0.0, 0.0, -0.13),
                124: (0.0, 0.0, -0.00)
            }
            float xformOp:rotateX = 45  # Rotate around red X-axis
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateX"]
            rel material:binding = </Scene/Materials/RedMaterial>

        }


    def SphereLight "PointLightAboveCube" (
        prepend apiSchemas = ["UsdLuxShapingAPI"]
    )
        {
            color3f inputs:color = (0, 0, 1)
            float inputs:intensity = 100000
            float inputs:radius = 0.04
            float3 xformOp:translate = (0, 2, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

    def Sphere "LightVisualSphere" (
        prepend apiSchemas = ["UsdShadeMaterialBindingAPI"]
    )
        {
            float radius = 0.005  
            float3 xformOp:translate.timeSamples = {
                0:   (4.00, 2.0,  0.00),
                2:   (3.70, 2.0,  1.54),
                4:   (2.82, 2.0,  2.82),
                6:   (1.54, 2.0,  3.70),
                8:   (0.00, 2.0,  4.00),
                10:  (-1.54, 2.0,  3.70),
                12:  (-2.82, 2.0,  2.82),
                14:  (-3.70, 2.0,  1.54),
                16:  (-4.00, 2.0,  0.00),
                18:  (-3.70, 2.0, -1.54),
                20:  (-2.82, 2.0, -2.82),
                22:  (-1.54, 2.0, -3.70),
                24:  (0.00, 2.0, -4.00),
