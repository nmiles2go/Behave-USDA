                80:  (-3.70, 2.0, -1.54),
                82:  (-2.82, 2.0, -2.82),
                84:  (-1.54, 2.0, -3.70),
                86:  (0.00, 2.0, -4.00),
                88:  (1.54, 2.0, -3.70),
                90:  (2.82, 2.0, -2.82),
                92:  (3.70, 2.0, -1.54),
