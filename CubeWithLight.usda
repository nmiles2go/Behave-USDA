                106: (-2.82, 2.0,  2.82),
                108: (-3.70, 2.0,  1.54),
                110: (-4.00, 2.0,  0.00),
                112: (-3.70, 2.0, -1.54),
                114: (-2.82, 2.0, -2.82),
                116: (-1.54, 2.0, -3.70),
                118: (0.00, 2.0, -4.00),
                120: (1.54, 2.0, -3.70),
                122: (2.82, 2.0, -2.82),
                123: (3.70, 2.0, -1.54),
                124: (4.00, 2.0,  0.00)
            }

            uniform token[] xformOpOrder = ["xformOp:translate"]
            rel material:binding = </Scene/Materials/GlowingMaterial>
        }


    def DistantLight "SunLight"
    {
        color3f inputs:color = (1.0, 1.0, 1.0)
        float inputs:intensity = 100000
        float inputs:angle = 0.53  # like the sun's angular size

        float3 xformOp:orient = (0.0, 0.0, -1.0)

        uniform token[] xformOpOrder = ["xformOp:orient"]
    }

def Scope "Materials"
    {
        def Material "RedMaterial"
        {
            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1.0, 0.0, 0.0)
                token outputs:surface
            }

            token outputs:surface.connect = </Scene/Materials/RedMaterial/PreviewSurface.outputs:surface>
        }

        def Material "GlowingMaterial"
        {
            def Shader "Glow"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:emissiveColor = (0.0, 1.0, 0.0)
                token outputs:surface
            }

            token outputs:surface.connect = </Scene/Materials/GlowingMaterial/Glow.outputs:surface>
        }
    }
}


